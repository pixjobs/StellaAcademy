# Stella Academy: local settings.
# Copy this file to `.env.local` (which git ignores) and fill in what you need.
# Everything here is optional; the site runs without any of it.

# Key for NASA's Astronomy Picture of the Day (https://api.nasa.gov).
# Without it the site uses NASA's shared DEMO_KEY, which is heavily rate limited.
NASA_API_KEY=

# How long the picture of the day is cached, in seconds. Defaults to one day.
# APOD_REVALIDATE_SEC=86400

# Read when the site is built, not when it runs:

# Google Analytics measurement ID. Defaults to the live site's ID (src/lib/site.ts).
# NEXT_PUBLIC_GA_ID=

# Address of the page "Support Stella" opens. Defaults to the Ko-fi page (src/lib/site.ts).
# NEXT_PUBLIC_SUPPORT_URL=
